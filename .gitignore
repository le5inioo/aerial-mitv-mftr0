.gradle/
build/
local.properties
.idea/
*.iml
.kotlin/

# Machine- and household-specific: TV addresses, signing key. Hand over privately.
local/
.DS_Store

# Copied into the website by tools/deploy-site.sh: the latest release's APKs and the install scripts.
site/download/
site/tools/
site/install.sh
site/icons/

# Wrangler state and the account cache (account id, e-mail).
.wrangler/

# Python bytecode from tools/ (tests run with python3)
__pycache__/
*.pyc

# What tools/rescue.sh wrote down on the machine it ran on (screen black, TV unreachable).
tools/rescue-*.log

# Build products kept next to the source while testing, never committed
*.apk

# The full Bahnschrift face is a Microsoft-bundled font: keep it out of the tree. Only the
# digit subset app/src/main/res/font/flipdigits.ttf is committed (copyright records kept).
app/src/main/res/font/bahnschrift.ttf
